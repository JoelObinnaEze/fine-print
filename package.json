{
  "name": "fine-print",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:web",
    "build:types": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "benchmark:discovery": "npm run build:types && node --env-file=.env dist/scripts/run-discovery-benchmark.js",
    "benchmark:frozen": "npm run build:types && node --env-file=.env dist/scripts/run-frozen-benchmark.js",
    "check:meta": "npm run build && node --env-file=.env dist/scripts/check-meta-compatibility.js",
    "dev": "vite --config apps/web/vite.config.ts",
    "evaluate": "npm run build:types && node dist/scripts/evaluate.js",
    "export:run": "npm run build:types && node --env-file=.env dist/scripts/export-run.js",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "smoke:meta-attacker": "npm run build:types && node --env-file=.env dist/scripts/smoke-meta-attacker.js",
    "smoke:meta-translation": "npm run build:types && node --env-file=.env dist/scripts/smoke-meta-translation.js",
    "start:server": "npm run build:types && node --env-file=.env dist/apps/server/src/main.js",
    "test": "vitest run",
    "test:web": "vitest run tests/web",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
